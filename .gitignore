!data/second_source/manifest.json

# Forward shadow log is intentionally tracked for scheduled continuity
!data/shadow/
!data/shadow/.gitkeep
!data/shadow/forward_shadow.sqlite

# System files
.DS_Store

# Large local MT5 / execution-replay data: keep local only
data/second_source/second_source.sqlite
data/reports/
data/reports/*
