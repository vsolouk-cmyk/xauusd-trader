# Local MT5 second-source data: do not commit
data/second_source/second_source.sqlite
data/second_source/manifest.json

# Local execution replay reports
data/reports/
data/reports/*

# Local XAUUSD runtime/evidence store - do not commit
data/local/*.sqlite
