{
  "stage": "Stage101_REPO_HYGIENE_CLEANUP_AUDIT",
  "gitignore_block_marker_start": "# BEGIN XAUUSD runtime/artifact ignores - Stage101",
  "gitignore_block_marker_end": "# END XAUUSD runtime/artifact ignores - Stage101",
  "runtime_ignore_patterns": [
    "reports/",
    "_incoming*/",
    "*.zip",
    "__pycache__/",
    ".pytest_cache/",
    ".DS_Store",
    "data/local/",
    "data/mt5_bridge/*.csv",
    "data/external_frontiers/",
    "data/frontier_templates/*.csv",
    "data/macro_regime/normalized/*.csv",
    "data/macro_regime/raw/",
    "data/exogenous/*.csv",
    "data/exogenous/*.json",
    "*.sqlite",
    "*.sqlite3",
    "*.db"
  ],
  "tracked_cleanup_roots": [
    "reports",
    "data/local",
    "data/mt5_bridge",
    "data/external_frontiers",
    "data/frontier_templates",
    "data/macro_regime/normalized",
    "data/macro_regime/raw",
    "data/exogenous"
  ],
  "tracked_cleanup_globs": [
    "*.zip",
    "**/__pycache__",
    "**/.pytest_cache",
    "*.sqlite",
    "*.sqlite3",
    "*.db"
  ],
  "safe_untrack_only": true,
  "forbidden_delete": true
}
