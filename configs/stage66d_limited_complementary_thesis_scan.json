        {"field": "dxy_sma20_over_50", "operator": "<", "threshold": 0.0},
        {"field": "dxy_ret_20d", "operator": "<", "threshold": 0.0}
      ]
    },
    {
      "thesis_id": "D4_VOL_RISK_OFF_REALYIELD_GOLD_LONG",
