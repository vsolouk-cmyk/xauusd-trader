      "conditions": [
        {"field": "gold_sma20_over_50", "operator": ">", "threshold": 0.0},
        {"field": "vix_change_20d", "operator": ">", "threshold": 0.0},
        {"field": "real_yield_change_20d", "operator": "<", "threshold": 0.0}
      ]
