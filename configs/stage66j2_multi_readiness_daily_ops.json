{
  "stage": "Stage66J2_MULTI_READINESS_DAILY_OPS",
  "purpose": "Run or collect Stage66J and Stage66K, then produce one no-order readiness dashboard for H64L v2, D3 H60, and backup D1/D4 H60.",
  "children": [
    {
      "stage_key": "stage66j",
      "enabled": true,
      "summary_path": "reports/stage66j_dual_readiness_daily_ops/stage66j_dual_readiness_daily_ops_summary.json",
      "timeout_seconds": 1200,
      "cmd": [
        "{python}",
        "app/stage66j_dual_readiness_daily_ops.py",
        "--root",
        "{root}",
        "--config",
        "configs/stage66j_dual_readiness_daily_ops.json",
        "--out",
        "reports/stage66j_dual_readiness_daily_ops"
      ]
    },
    {
      "stage_key": "stage66k",
      "enabled": true,
      "summary_path": "reports/stage66k_complementary_backup_readiness_expansion/stage66k_complementary_backup_readiness_expansion_summary.json",
      "timeout_seconds": 900,
      "cmd": [
        "{python}",
        "app/stage66k_complementary_backup_readiness_expansion.py",
        "--root",
        "{root}",
        "--config",
        "configs/stage66k_complementary_backup_readiness_expansion.json",
        "--out",
        "reports/stage66k_complementary_backup_readiness_expansion"
      ]
    }
  ],
  "input_paths": {
    "stage66j_summary_path": "reports/stage66j_dual_readiness_daily_ops/stage66j_dual_readiness_daily_ops_summary.json",
    "stage66k_summary_path": "reports/stage66k_complementary_backup_readiness_expansion/stage66k_complementary_backup_readiness_expansion_summary.json"
  },
  "ledger_csv": "data/forward_shadow/stage66j2_multi_readiness_daily_ops_ledger.csv",
  "hard_blocks": [
    "NO_AUTOMATED_ORDER",
    "NO_PAPER_ORDER",
    "NO_BROKER_CONNECTION",
    "NO_EA_PROMOTION",
    "NO_PAPER_LIVE",
    "NO_LIVE",
    "NO_ORDER_AUTHORIZATION_FROM_STAGE66J2",
    "NO_THRESHOLD_TUNING",
    "NO_PROMOTION_FROM_DAILY_OPS_ONLY"
  ]
}