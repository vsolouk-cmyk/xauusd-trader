{
  "stage": "Stage68D_CLUSTER_RETURN_SELECTION_POLICY",
  "inputs": {
    "rule_entry_returns_csv": "reports/stage68c_return_incremental_value_audit/stage68c_rule_entry_returns.csv"
  },
  "outputs": {
    "summary_json": "stage68d_cluster_return_selection_policy_summary.json",
    "report_md": "stage68d_cluster_return_selection_policy_report.md",
    "policy_comparison_csv": "stage68d_policy_comparison.csv",
    "selected_entries_csv": "stage68d_selected_cluster_entries.csv"
  },
  "cluster_window_calendar_days": 60,
  "cost_bps_total": 50.0,
  "policies": [
    {"policy_id": "QUALITY_FIRST_EXCLUDE_D1", "priority": ["h64l_v2", "d3_h60", "d4_backup"], "allow_rules": ["h64l_v2", "d3_h60", "d4_backup"]},
    {"policy_id": "H64L_FIRST_ALL", "priority": ["h64l_v2", "d3_h60", "d4_backup", "d1_backup"], "allow_rules": ["h64l_v2", "d3_h60", "d4_backup", "d1_backup"]},
    {"policy_id": "D3_FIRST_EXCLUDE_D1", "priority": ["d3_h60", "h64l_v2", "d4_backup"], "allow_rules": ["d3_h60", "h64l_v2", "d4_backup"]},
    {"policy_id": "D4_FIRST_EXCLUDE_D1", "priority": ["d4_backup", "h64l_v2", "d3_h60"], "allow_rules": ["d4_backup", "h64l_v2", "d3_h60"]},
    {"policy_id": "D3_D4_ONLY", "priority": ["d3_h60", "d4_backup"], "allow_rules": ["d3_h60", "d4_backup"]},
    {"policy_id": "D1_REFERENCE_ONLY", "priority": ["d1_backup"], "allow_rules": ["d1_backup"]}
  ],
  "diagnostic_oracle_policy_id": "ORACLE_BEST_IN_CLUSTER_DIAGNOSTIC_ONLY",
  "selection_constraints": {
    "min_entry_count": 20,
    "min_win_rate": 0.55,
    "min_mean_net_return_bps": 150.0,
    "max_abs_worst_loss_bps": 1300.0
  },
  "hard_blocks": [
    "NO_AUTOMATED_ORDER",
    "NO_PAPER_ORDER",
    "NO_BROKER_CONNECTION",
    "NO_EA_PROMOTION",
    "NO_PAPER_LIVE",
    "NO_LIVE",
    "NO_ORDER_AUTHORIZATION_FROM_STAGE68D",
    "NO_THRESHOLD_TUNING_FROM_CLUSTER_SELECTION",
    "NO_PROMOTION_FROM_POLICY_AUDIT_ONLY"
  ]
}
