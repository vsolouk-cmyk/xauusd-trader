{
  "stage": "Stage93_COT_EVENT_FRONTIER_READINESS_BUILDER",
  "principle": "After macro-only residual and intraday/session residual discovery failed to produce a shortlist, prepare external data frontiers for thesis-first discovery without orders or MT5 changes.",
  "reference_reports": {
    "stage88": "reports/stage88_daily_unified_observer_combo/stage88_daily_unified_observer_combo_summary.json",
    "stage89": "reports/stage89_residual_regime_thesis_discovery/stage89_residual_regime_thesis_discovery_summary.json",
    "stage91": "reports/stage91_intraday_frontier_readiness_router/stage91_intraday_frontier_readiness_router_summary.json",
    "stage92": "reports/stage92_intraday_session_residual_thesis_discovery/stage92_intraday_session_residual_thesis_discovery_summary.json"
  },
  "scan_roots": [
    "data",
    "data/exogenous",
    "data/macro_regime",
    "reports",
    "~/Downloads"
  ],
  "cot_filename_keywords": ["cot", "cftc", "commitment", "traders", "futures_only", "disaggregated"],
  "event_filename_keywords": ["calendar", "event", "events", "surprise", "macro_event", "economic_calendar"],
  "minimum_ready_rows": {
    "cot": 300,
    "event_surprise": 500
  },
  "required_columns": {
    "cot_normalized": [
      "report_date_utc",
      "available_after_utc",
      "market",
      "contract",
      "open_interest",
      "managed_money_long",
      "managed_money_short",
      "managed_money_spreading"
    ],
    "event_surprise_normalized": [
      "event_datetime_utc",
      "available_after_utc",
      "country",
      "event_type",
      "event_name",
      "actual",
      "consensus",
      "previous",
      "surprise"
    ]
  },
  "output_templates_dir": "data/frontier_templates",
  "hard_blocks": [
    "NO_AUTOMATED_ORDER",
    "NO_PAPER_ORDER",
    "NO_BROKER_CONNECTION",
    "NO_EA_PROMOTION",
    "NO_PAPER_LIVE",
    "NO_LIVE",
    "NO_ORDER_AUTHORIZATION_FROM_STAGE93",
    "NO_THRESHOLD_TUNING_FROM_STAGE93_READINESS",
    "NO_DIRECT_MT5_OR_EA_CHANGE_FROM_STAGE93"
  ]
}
