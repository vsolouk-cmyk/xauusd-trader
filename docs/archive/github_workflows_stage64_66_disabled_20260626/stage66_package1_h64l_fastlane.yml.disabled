name: Stage66 Package1 H64L Fastlane

on:
  workflow_dispatch:
    inputs:
      run_stage66b:
        description: "Run Stage66B rolling-origin replay after Stage66A"
        required: true
        default: "true"
        type: choice
        options:
          - "true"
          - "false"

permissions:
  contents: read
  actions: read

jobs:
  stage66-package1:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Stage66 data integrity crosscheck
        run: |
          python3 app/stage66_data_integrity_crosscheck.py \
            --root . \
            --config configs/stage66_data_integrity_crosscheck.json \
            --out reports/stage66_data_integrity_crosscheck

      - name: Stage66A H64L concentration audit
        run: |
          python3 app/stage66a_h64l_concentration_audit.py \
            --root . \
            --config configs/stage66a_h64l_concentration_audit.json \
            --out reports/stage66a_h64l_concentration_audit \
            --write-events

      - name: Stage66B no-lookahead tests
        run: |
          python3 tests/test_stage66b_no_lookahead.py

      - name: Stage66B rolling-origin replay
        if: ${{ inputs.run_stage66b == 'true' }}
        run: |
          python3 app/stage66b_h64l_rolling_origin_replay.py \
            --root . \
            --config configs/stage66b_h64l_rolling_origin_replay.json \
            --out reports/stage66b_h64l_rolling_origin_replay

      - name: Stage66F governance dashboard
        if: always()
        run: |
          python3 app/stage66f_governance_dashboard.py \
            --root . \
            --out reports/stage66f_governance_dashboard

      - name: Upload Stage66 reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: stage66-package1-reports
          path: |
            reports/stage66_data_integrity_crosscheck/**
            reports/stage66a_h64l_concentration_audit/**
            reports/stage66b_h64l_rolling_origin_replay/**
            reports/stage66f_governance_dashboard/**
          if-no-files-found: warn
