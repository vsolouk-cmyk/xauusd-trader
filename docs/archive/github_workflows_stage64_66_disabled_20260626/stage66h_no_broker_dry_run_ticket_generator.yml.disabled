name: Stage66H No-Broker Dry-Run Ticket Generator

on:
  workflow_dispatch:
  schedule:
    - cron: '17 4 * * 1-5'

jobs:
  stage66h:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Run tests
        run: |
          python3 tests/test_stage66h_no_broker_dry_run_ticket_generator.py
      - name: Run Stage66H
        run: |
          python3 app/stage66h_no_broker_dry_run_ticket_generator.py \
            --root . \
            --config configs/stage66h_no_broker_dry_run_ticket_generator.json \
            --out reports/stage66h_no_broker_dry_run_ticket_generator
      - name: Upload Stage66H reports
        uses: actions/upload-artifact@v4
        with:
          name: stage66h-no-broker-dry-run-ticket-generator
          path: |
            reports/stage66h_no_broker_dry_run_ticket_generator/*.json
            reports/stage66h_no_broker_dry_run_ticket_generator/*.md
