name: Stage66I No-Broker Complementary Dry-Run Ticket Generator

on:
  workflow_dispatch:
  schedule:
    - cron: "20 6 * * 1-5"

jobs:
  stage66i:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Run Stage66I tests
        run: python3 tests/test_stage66i_no_broker_complementary_dry_run_ticket_generator.py
      - name: Run Stage66I generator
        run: |
          python3 app/stage66i_no_broker_complementary_dry_run_ticket_generator.py \
            --root . \
            --config configs/stage66i_no_broker_complementary_dry_run_ticket_generator.json \
            --out reports/stage66i_no_broker_complementary_dry_run_ticket_generator
      - name: Commit reports
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@github.com"
          git add reports/stage66i_no_broker_complementary_dry_run_ticket_generator || true
          git commit -m "run stage66i complementary dry-run ticket generator" || echo "No changes to commit"
          git push || true
