name: Stage66J2 Multi Readiness Daily Ops

on:
  workflow_dispatch:
    inputs:
      run_children:
        description: "Run Stage66J and Stage66K before collecting"
        required: true
        default: "true"
  schedule:
    - cron: "20 6 * * 1-5"

jobs:
  stage66j2:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Run tests
        run: python tests/test_stage66j2_multi_readiness_daily_ops.py
      - name: Run Stage66J2
        run: |
          if [ "${{ github.event.inputs.run_children }}" = "false" ]; then
            python app/stage66j2_multi_readiness_daily_ops.py --root . --config configs/stage66j2_multi_readiness_daily_ops.json --out reports/stage66j2_multi_readiness_daily_ops --no-run
          else
            python app/stage66j2_multi_readiness_daily_ops.py --root . --config configs/stage66j2_multi_readiness_daily_ops.json --out reports/stage66j2_multi_readiness_daily_ops
          fi
      - name: Upload Stage66J2 artifacts
        uses: actions/upload-artifact@v4
        with:
          name: stage66j2-multi-readiness-daily-ops
          path: |
            reports/stage66j2_multi_readiness_daily_ops/**
            data/forward_shadow/stage66j2_multi_readiness_daily_ops_ledger.csv
