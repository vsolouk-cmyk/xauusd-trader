name: Stage66J Dual Readiness Daily Ops

on:
  workflow_dispatch:
    inputs:
      collect_only_no_run:
        description: "Collect existing child summaries without running child stages"
        required: false
        default: "false"
  schedule:
    - cron: "17 5 * * 1-5"

jobs:
  stage66j:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Run Stage66J dual readiness daily ops
        run: |
          EXTRA=""
          if [ "${{ github.event.inputs.collect_only_no_run }}" = "true" ]; then
            EXTRA="--no-run"
          fi
          python app/stage66j_dual_readiness_daily_ops.py \
            --root . \
            --config configs/stage66j_dual_readiness_daily_ops.json \
            --out reports/stage66j_dual_readiness_daily_ops \
            $EXTRA
      - name: Upload Stage66J artifacts
        uses: actions/upload-artifact@v4
        with:
          name: stage66j-dual-readiness-daily-ops
          path: |
            reports/stage66j_dual_readiness_daily_ops/**
            data/forward_shadow/stage66j_dual_readiness_daily_ops_ledger.csv
