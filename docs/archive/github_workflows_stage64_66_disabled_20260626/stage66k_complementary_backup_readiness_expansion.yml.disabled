name: Stage66K Complementary Backup Readiness Expansion

on:
  workflow_dispatch: {}

jobs:
  stage66k:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Test Stage66K
        run: python3 tests/test_stage66k_complementary_backup_readiness_expansion.py
      - name: Run Stage66K
        run: |
          python3 app/stage66k_complementary_backup_readiness_expansion.py \
            --root . \
            --config configs/stage66k_complementary_backup_readiness_expansion.json \
            --out reports/stage66k_complementary_backup_readiness_expansion
      - name: Upload Stage66K reports
        uses: actions/upload-artifact@v4
        with:
          name: stage66k-complementary-backup-readiness-expansion
          path: |
            reports/stage66k_complementary_backup_readiness_expansion/**
            configs/stage66k_backup_complementary_rule_locks.json
            data/forward_shadow/stage66k_backup_complementary_readiness_ledger.csv
